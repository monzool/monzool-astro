
#
#   MM   MM   OOO   NN   N  ZZZZZ   OOO    OOO   L        NN   N  EEEE  TTTTT
#   M M M M  O   O  N N  N     Z   O   O  O   O  L        N N  N  E       T
#   M  M  M  O   O  N  N N    Z    O   O  O   O  L        N  N N  EEE     T
#   M     M  O   O  N   NN   Z     O   O  O   O  L        N   NN  E       T
#   M     M   OOO   N    N  ZZZZZ   OOO    OOO   LLLL  o  N    N  EEEE    T
#


<Files .htaccess>
order allow,deny
deny from all
</Files>

<Limit PUT DELETE>
order deny,allow
deny from all
</Limit>

# Legacy WordPress feed URLs -> Astro feed
# (/blog/feed, /blog/feed/, /blog/feed/rss2/, /blog/feed/atom/, ...)
RedirectMatch 301 ^/blog/feed(/.*)?$ /rss.xml

# Legacy query-string feeds (/blog/?feed=rss2, /?feed=rss2, ...)
<IfModule mod_rewrite.c>
RewriteEngine On
RewriteCond %{QUERY_STRING} (^|&)feed= [NC]
RewriteRule ^(blog/?)?$ /rss.xml? [R=301,L]
</IfModule>

# Protect wp-config.php
<files wp-config.php>
order allow,deny
deny from all
</files>
